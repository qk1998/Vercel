{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "TIDB_HOST": "@tidb_host",
    "TIDB_PORT": "@tidb_port",
    "TIDB_USER": "@tidb_user",
    "TIDB_PASSWORD": "@tidb_password",
    "TIDB_DATABASE": "@tidb_database",
    "BLOB_READ_WRITE_TOKEN": "@blob_token"
  }
}
